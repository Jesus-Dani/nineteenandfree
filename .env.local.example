# Copy this file to .env.local and fill in real values for local development.
# These are the exact variable names already configured in Vercel (TRD Section 1a) — do not rename them.
# Use Paystack TEST MODE keys for local development. Never commit .env.local.

# Server-side Paystack API calls (initialize/verify transactions) and webhook signature verification.
PAYSTACK_SECRET_KEY=

# Client-side Paystack checkout initialization.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://nhhsmbyekdqlbvahobke.supabase.co

# Supabase client-side data access (publishable key — safe for the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Full database access for server-side operations only. NEVER expose to client code.
SUPABASE_SECRET_KEY=

# Single-admin dashboard login password.
ADMIN_PASSWORD=
